{
	"name": "@vrogd/uploader",
	"version": "0.0.121",
	"scripts": {
		"dev": "vite dev && npm link",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build-sass": "rollup -c",
		"dev-sass": "rollup -c -w"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/Upload.svelte",
			"style": "./sass/app.scss",
			"default": "./dist/index.js"
		},
		"./Upload.svelte": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/Upload.svelte"
		},
		"./output.css": "./static/output.css"
	},
	"svelte": "./dist/Upload.svelte",
	"files": [
		"dist",
		"static/output.css",
		"sass/**/*.scss",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.58.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"publint": "^0.3.18",
		"rollup-plugin-sass": "^1.15.3",
		"sass": "^1.105.0",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"rollup": "^4.62.2"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module"
}
